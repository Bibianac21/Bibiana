# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).

# Used by the app (client-side) and by `npm run seed`.
VITE_SUPABASE_URL=

# Public anon key — safe to expose in the browser bundle, RLS enforces access.
VITE_SUPABASE_ANON_KEY=

# Service role key — used ONLY by `npm run seed` (a local Node script), to
# bypass RLS for the initial bulk import. Never expose this in the app or
# commit it; it grants full read/write access to the whole project.
SUPABASE_SERVICE_ROLE_KEY=
